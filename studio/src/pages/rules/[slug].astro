---
import Layout from '../../components/layout/Layout.astro'
import Badge from '../../components/ui/Badge.astro'
import CopyButton from '../../components/ui/CopyButton.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const rules = await getCollection('rules')
  return rules.map(r => ({ params: { slug: r.id } }))
}

const { slug } = Astro.params
const rules = await getCollection('rules')
const rule = rules.find(r => r.id === slug)

if (!rule) return Astro.redirect('/rules')

const { Content, body } = await render(rule)

const typeLabel: Record<string, string> = { claude: 'Claude Rules', cursor: 'Cursor Rules', codex: 'Codex Rules' }
const typeVariant: Record<string, 'accent' | 'warning' | 'default'> = {
  claude: 'accent', cursor: 'warning', codex: 'default',
}
---
<Layout title={rule.data.name} description={rule.data.description}>

  <div style="max-width: 1280px; margin: 0 auto; padding: 3rem 1.5rem;">

    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 2rem;">
      <a href="/" style="color: var(--color-text-subtle); font-size: 0.8125rem; text-decoration: none;">Home</a>
      <span style="color: var(--color-text-subtle);">/</span>
      <a href="/rules" style="color: var(--color-text-subtle); font-size: 0.8125rem; text-decoration: none;">Rules</a>
      <span style="color: var(--color-text-subtle);">/</span>
      <span style="color: var(--color-text-muted); font-size: 0.8125rem;">{rule.data.name}</span>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 300px; gap: 3rem; align-items: start;">

      <!-- Main -->
      <div>
        <div style="margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 0;">
              {rule.data.name_zh ? (
                <div>
                  <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.125rem; letter-spacing: -0.02em;">
                    {rule.data.name_zh}
                  </h1>
                  <div style="font-size: 0.875rem; color: var(--color-text-subtle); font-family: var(--font-mono);">
                    {rule.data.name}
                  </div>
                </div>
              ) : (
                <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--color-text); margin: 0; letter-spacing: -0.02em;">
                  {rule.data.name}
                </h1>
              )}
              {rule.data.source && (
                <div style="font-size: 0.75rem; color: var(--color-warning); background: rgba(245,158,11,0.1); display: inline-flex; align-items: center; padding: 0.125rem 0.5rem; border-radius: 3px; margin-top: 0.375rem;">
                  {rule.data.source}
                </div>
              )}
            </div>
            <Badge variant={typeVariant[rule.data.rule_type]}>{typeLabel[rule.data.rule_type]}</Badge>
          </div>
          <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin: 0.75rem 0 0; line-height: 1.5;">
            {rule.data.description}
          </p>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 2.5rem;">
          {rule.data.tags.map(tag => (
            <span style="font-size:0.75rem;color:var(--color-text-subtle);background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:3px;padding:0.125rem 0.5rem;">{tag}</span>
          ))}
        </div>

        <div style="
          background: var(--color-surface); border: 1px solid var(--color-border);
          border-radius: var(--radius-md); overflow: hidden; margin-bottom: 2rem;
        ">
          <div style="
            padding: 0.625rem 0.875rem; border-bottom: 1px solid var(--color-border);
            display: flex; align-items: center; justify-content: space-between;
            background: var(--color-surface-2);
          ">
            <span style="font-size:0.75rem;color:var(--color-text-muted);font-family:var(--font-mono);">
              rules/{rule.data.file_name}
            </span>
            <CopyButton text={body ?? ''} label="复制文件内容" />
          </div>
          <div class="prose" style="padding: 1.25rem;">
            <Content />
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div style="position: sticky; top: 80px; display: flex; flex-direction: column; gap: 1rem;">

        <button
          id="add-to-ws"
          data-slug={rule.id}
          style="
            width: 100%;
            background: var(--color-accent); color: white; border: none;
            padding: 0.75rem 1rem; border-radius: var(--radius-md);
            font-size: 0.9375rem; font-weight: 600; cursor: pointer;
            font-family: inherit; transition: all 0.15s;
            display: flex; align-items: center; justify-content: center; gap: 0.5rem;
          "
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
          <span id="btn-label">添加到 Workspace</span>
        </button>

        <div style="
          background: var(--color-surface); border: 1px solid var(--color-border);
          border-radius: var(--radius-md); padding: 0.875rem;
          display: flex; flex-direction: column; gap: 0.625rem;
        ">
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.75rem;color:var(--color-text-subtle);">类型</span>
            <Badge variant={typeVariant[rule.data.rule_type]}>{typeLabel[rule.data.rule_type]}</Badge>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.75rem;color:var(--color-text-subtle);">作者</span>
            <span style="font-size:0.8125rem;color:var(--color-text-muted);">{rule.data.author}</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:0.75rem;color:var(--color-text-subtle);">输出文件</span>
            <code style="font-size:0.75rem;color:var(--color-accent);">{rule.data.file_name}</code>
          </div>
          <div style="display:flex;flex-direction:column;gap:0.25rem;">
            <span style="font-size:0.75rem;color:var(--color-text-subtle);">分类</span>
            <div style="display:flex;gap:0.25rem;flex-wrap:wrap;">
              {rule.data.category.map(cat => (
                <span style="font-size:0.6875rem;color:var(--color-text-subtle);background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:3px;padding:0.1rem 0.35rem;">{cat}</span>
              ))}
            </div>
          </div>
        </div>

        {(rule.data.source || rule.data.github_url || rule.data.stars !== undefined || rule.data.use_cases.length > 0) && (
          <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:0.875rem;display:flex;flex-direction:column;gap:0.625rem;">
            <h2 style="font-size:0.75rem;font-weight:600;color:var(--color-text-subtle);text-transform:uppercase;letter-spacing:0.06em;margin:0;">Source & Links</h2>
            {rule.data.source && <div style="font-size:0.8125rem;color:var(--color-text-muted);line-height:1.4;">来源：{rule.data.source}</div>}
            {rule.data.stars !== undefined && <div style="font-size:0.8125rem;color:var(--color-text-muted);">GitHub Stars：★ {rule.data.stars.toLocaleString()}</div>}
            {rule.data.updated_at && <div style="font-size:0.8125rem;color:var(--color-text-muted);">最后更新：{rule.data.updated_at.slice(0, 10)}</div>}
            {rule.data.use_cases.length > 0 && (
              <div style="display:flex;flex-direction:column;gap:0.25rem;">
                <span style="font-size:0.75rem;color:var(--color-text-subtle);">适合谁 / 使用场景</span>
                {rule.data.use_cases.map(item => <span style="font-size:0.8125rem;color:var(--color-text-muted);line-height:1.4;">{item}</span>)}
              </div>
            )}
            {rule.data.github_url && (
              <a href={rule.data.github_url} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;justify-content:center;color:var(--color-text);text-decoration:none;font-size:0.8125rem;background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:var(--radius-sm);padding:0.5rem 0.75rem;">
                原始规则链接
              </a>
            )}
          </div>
        )}

      </div>
    </div>
  </div>
</Layout>

<script>
  import { addRule, isInWorkspace } from '../../stores/workspace'

  const btn = document.getElementById('add-to-ws') as HTMLButtonElement
  const label = document.getElementById('btn-label')
  if (btn && label) {
    const slug = btn.dataset.slug!
    function updateBtn() {
      if (isInWorkspace('rule', slug)) {
        label!.textContent = '✓ 已添加到 Workspace'
        btn!.style.background = 'var(--color-surface-2)'
        btn!.style.color = 'var(--color-success)'
        btn!.style.border = '1px solid rgba(34,197,94,0.3)'
      }
    }
    updateBtn()
    btn.addEventListener('click', () => {
      addRule(slug)
      updateBtn()
    })
  }
</script>
