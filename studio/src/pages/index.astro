---
import Layout from '../components/layout/Layout.astro'
import { getCollection } from 'astro:content'

const mcps = await getCollection('mcp')
const skills = await getCollection('skills')
const rules = await getCollection('rules')

// Sample preset resources for workspace preview
const previewMcps = ['GitHub MCP', 'Filesystem MCP', 'Brave Search MCP']
const previewSkills = ['SEO Writer', 'Research Agent', 'Content Factory']
const previewRules = ['Astro Rules', 'TypeScript Rules']
---
<Layout title="The Visual Workspace for Claude Code">

  <!-- Hero -->
  <section style="
    padding: 4.5rem 1.5rem 3.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  ">
    <div style="
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(91,106,248,0.18) 0%, transparent 65%);
      pointer-events: none;
    "></div>

    <div style="max-width: 760px; margin: 0 auto; position: relative;">
      <div style="
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border-2);
        border-radius: 100px;
        padding: 0.3rem 0.875rem;
        font-size: 0.75rem;
        color: var(--color-text-muted);
        margin-bottom: 1.75rem;
      ">
        ✨ 构建更好的 AI 工作流
      </div>

      <h1 style="
        font-size: clamp(2.25rem, 5vw, 3.75rem);
        font-weight: 700;
        line-height: 1.08;
        letter-spacing: -0.035em;
        color: var(--color-text);
        margin: 0 0 1.25rem;
      ">
        The Visual Workspace<br/>
        <span style="color: var(--color-accent);">for Claude Code</span>
      </h1>

      <p style="
        font-size: 1.125rem;
        color: var(--color-text-muted);
        line-height: 1.65;
        margin: 0 0 0.625rem;
        max-width: 560px;
        margin-left: auto;
        margin-right: auto;
      ">
        通过可视化界面完成 Claude Code 项目配置、管理与导出。
      </p>
      <p style="
        font-size: 0.9375rem;
        color: var(--color-text-subtle);
        margin: 0 0 2.5rem;
      ">
        无需编写配置文件，无需学习 MCP、Skills、Rules，开箱即用。
      </p>

      <div style="display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/workspace" style="
          background: var(--color-accent); color: white; text-decoration: none;
          padding: 0.8rem 1.875rem; border-radius: var(--radius-md);
          font-size: 0.9375rem; font-weight: 600; transition: background 0.15s;
          display: inline-flex; align-items: center; gap: 0.5rem;
        ">
          进入工作台
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/mcp" style="
          background: var(--color-surface); color: var(--color-text-muted); text-decoration: none;
          padding: 0.8rem 1.875rem; border-radius: var(--radius-md);
          font-size: 0.9375rem; font-weight: 500;
          border: 1px solid var(--color-border); transition: all 0.15s;
        ">
          浏览资源库
        </a>
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); background: var(--color-surface);">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;">
      {[
        { label: 'MCP Servers', value: mcps.length + '+', color: 'var(--color-accent)' },
        { label: 'Skills', value: skills.length + '+', color: 'var(--color-success)' },
        { label: 'Rules', value: rules.length + '+', color: 'var(--color-warning)' },
        { label: 'Always Free', value: '100%', color: 'var(--color-text)' },
      ].map((stat, i) => (
        <div style={`text-align: center; padding: 1.25rem 1rem; ${i < 3 ? 'border-right: 1px solid var(--color-border);' : ''}`}>
          <div style={`font-size: 1.75rem; font-weight: 700; color: ${stat.color}; letter-spacing: -0.03em; line-height: 1;`}>
            {stat.value}
          </div>
          <div style="font-size: 0.8rem; color: var(--color-text-subtle); margin-top: 0.2rem; text-transform: uppercase; letter-spacing: 0.04em;">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Workspace Preview (P3) -->
  <section style="padding: 4.5rem 1.5rem; background: var(--color-bg);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.625rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.625rem; letter-spacing: -0.02em;">
          Workspace — 一目了然
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin: 0;">
          选配完成后即可导出完整 Claude Code 项目，无需编写任何配置文件。
        </p>
      </div>

      <!-- Mock workspace UI -->
      <div style="
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: 0 32px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.04);
      ">
        <!-- Mock titlebar -->
        <div style="
          background: var(--color-surface-2);
          border-bottom: 1px solid var(--color-border);
          padding: 0.625rem 1rem;
          display: flex; align-items: center; gap: 0.5rem;
        ">
          <div style="display:flex;gap:0.4rem;">
            <div style="width:12px;height:12px;border-radius:50%;background:#ff5f57;"></div>
            <div style="width:12px;height:12px;border-radius:50%;background:#ffbd2e;"></div>
            <div style="width:12px;height:12px;border-radius:50%;background:#28ca41;"></div>
          </div>
          <div style="
            flex:1;text-align:center;font-size:0.75rem;color:var(--color-text-subtle);
            background:var(--color-bg);border:1px solid var(--color-border);border-radius:4px;
            padding:0.2rem 1rem;max-width:280px;margin:0 auto;
          ">
            flowbase.studio/workspace
          </div>
        </div>

        <!-- Mock workspace content -->
        <div style="display:grid;grid-template-columns:1fr 280px;gap:0;">
          <!-- Left panel -->
          <div style="padding: 1.5rem; border-right: 1px solid var(--color-border); display:flex;flex-direction:column;gap:1rem;">

            <!-- Presets row -->
            <div>
              <div style="font-size:0.6875rem;font-weight:600;color:var(--color-text-subtle);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.625rem;">Popular Presets</div>
              <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                {['🚀 Astro Blog', '📈 SEO Factory', '🤖 Telegram Bot', '💻 SaaS Starter'].map((p, i) => (
                  <div style={`
                    background: ${i === 1 ? 'var(--color-accent-subtle)' : 'var(--color-surface-2)'};
                    border: 1px solid ${i === 1 ? 'var(--color-accent)' : 'var(--color-border)'};
                    border-radius: 6px; padding: 0.375rem 0.75rem;
                    font-size: 0.75rem; color: ${i === 1 ? 'var(--color-accent)' : 'var(--color-text-muted)'};
                  `}>{p}</div>
                ))}
              </div>
            </div>

            <!-- Project name -->
            <div>
              <div style="font-size:0.6875rem;font-weight:600;color:var(--color-text-subtle);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.5rem;">Project</div>
              <div style="
                background:var(--color-surface-2);border:1px solid var(--color-accent);
                border-radius:5px;padding:0.375rem 0.625rem;font-size:0.8125rem;color:var(--color-text);
                display:inline-block;
              ">seo-content-factory</div>
            </div>

            <!-- MCP -->
            <div>
              <div style="font-size:0.6875rem;font-weight:600;color:var(--color-accent);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.5rem;">
                MCP Servers <span style="background:var(--color-accent-subtle);padding:0.1rem 0.35rem;border-radius:3px;">{previewMcps.length}</span>
              </div>
              {previewMcps.map(name => (
                <div style="display:flex;align-items:center;gap:0.5rem;padding:0.3rem 0;border-bottom:1px solid var(--color-border);">
                  <div style="width:14px;height:14px;border-radius:3px;background:var(--color-accent);flex-shrink:0;"></div>
                  <span style="font-size:0.8125rem;color:var(--color-text);">{name}</span>
                </div>
              ))}
            </div>

            <!-- Skills -->
            <div>
              <div style="font-size:0.6875rem;font-weight:600;color:var(--color-success);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.5rem;">
                Skills <span style="background:rgba(34,197,94,0.12);padding:0.1rem 0.35rem;border-radius:3px;">{previewSkills.length}</span>
              </div>
              {previewSkills.map(name => (
                <div style="display:flex;align-items:center;gap:0.5rem;padding:0.3rem 0;border-bottom:1px solid var(--color-border);">
                  <div style="width:14px;height:14px;border-radius:3px;background:var(--color-success);flex-shrink:0;"></div>
                  <span style="font-size:0.8125rem;color:var(--color-text);">{name}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Right output panel -->
          <div style="padding: 1.25rem; display:flex;flex-direction:column;gap:1rem;">
            <div>
              <div style="font-size:0.6875rem;font-weight:600;color:var(--color-text-subtle);text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.625rem;">Project Structure</div>
              <div style="font-family:var(--font-mono);font-size:0.75rem;color:var(--color-text-muted);line-height:1.75;background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:6px;padding:0.75rem;">
                <div style="color:var(--color-text);">📁 seo-content-factory/</div>
                <div style="padding-left:1rem;">
                  <div>├── CLAUDE.md</div>
                  <div>├── README.md</div>
                  <div>├── .claude/</div>
                  <div style="padding-left:1rem;">└── settings.json</div>
                  <div>├── skills/</div>
                  {previewSkills.map((s, i) => (
                    <div style="padding-left:1rem;color:var(--color-success);">
                      {i < previewSkills.length - 1 ? '├' : '└'}── {s.toLowerCase().replace(/\s+/g, '-')}.md
                    </div>
                  ))}
                  <div>└── rules/</div>
                  {previewRules.map((r, i) => (
                    <div style="padding-left:1rem;color:var(--color-warning);">
                      {i < previewRules.length - 1 ? '├' : '└'}── {r.toLowerCase().replace(/\s+/g, '-')}.md
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <a href="/workspace" style="
              background: var(--color-accent); color: white; text-decoration: none;
              padding: 0.75rem; border-radius: var(--radius-sm);
              font-size: 0.9rem; font-weight: 600;
              display: flex; align-items: center; justify-content: center; gap: 0.5rem;
              transition: background 0.15s;
            ">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
              </svg>
              Export ZIP
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section style="padding: 4.5rem 1.5rem; background: var(--color-surface); border-top: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="font-size: 1.625rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.625rem; letter-spacing: -0.02em;">
          三步完成配置
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.9375rem; margin: 0;">
          传统方式需要数小时，FBS 只需几分钟。
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
        {[
          { num: '01', title: '选择 MCP', desc: '从 20+ 个精选 MCP 服务中勾选工具 — GitHub、Browser、PostgreSQL 等。或直接应用预设。' },
          { num: '02', title: '添加 Skills & Rules', desc: '选择 AI 能力（Skills）和代码规范（Rules），按项目类型自由组合。' },
          { num: '03', title: 'Export ZIP', desc: 'CLAUDE.md + settings.json + skills/ + rules/ 完整打包，解压即用。' },
        ].map(step => (
          <div style="
            background: var(--color-surface-2); border: 1px solid var(--color-border);
            border-radius: var(--radius-lg); padding: 1.625rem; position: relative; overflow: hidden;
          ">
            <div style="
              position: absolute; top: 1rem; right: 1.25rem;
              font-size: 2.75rem; font-weight: 800; color: var(--color-border-2);
              line-height: 1; letter-spacing: -0.05em;
            ">{step.num}</div>
            <h3 style="font-size: 1rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.5rem;">{step.title}</h3>
            <p style="font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6; margin: 0;">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features grid -->
  <section style="padding: 4.5rem 1.5rem; border-top: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 3rem;">
        <h2 style="font-size: 1.625rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.625rem; letter-spacing: -0.02em;">
          为什么选 FlowBase Studio
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">
        {[
          { icon: '⚡', title: '零门槛上手', desc: '无需了解 JSON 格式或配置语法，可视化界面即可完成完整配置。' },
          { icon: '📦', title: '真实文件输出', desc: '下载 ZIP 包含所有文件，解压放入项目目录，打开 Claude Code 即用。' },
          { icon: '🚀', title: '预设加速', desc: '6 种场景预设一键配置，Astro Blog、SaaS、Telegram Bot 等开箱即用。' },
          { icon: '🌐', title: '中文优先', desc: '面向中文用户的 Claude Code 工作台，内容与配置流程完整中文化。' },
        ].map(f => (
          <div style="
            background: var(--color-surface); border: 1px solid var(--color-border);
            border-radius: var(--radius-md); padding: 1.375rem;
          ">
            <div style="font-size: 1.375rem; margin-bottom: 0.625rem;">{f.icon}</div>
            <h3 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.4rem;">{f.title}</h3>
            <p style="font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.6; margin: 0;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section style="
    padding: 5rem 1.5rem; text-align: center;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  ">
    <div style="max-width: 520px; margin: 0 auto;">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.875rem; letter-spacing: -0.02em;">
        立即开始配置
      </h2>
      <p style="color: var(--color-text-muted); margin: 0 0 2rem; font-size: 0.9375rem; line-height: 1.6;">
        无需注册，无需信用卡。打开 Studio，选配，Export ZIP，完成。
      </p>
      <a href="/workspace" style="
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: var(--color-accent); color: white; text-decoration: none;
        padding: 0.9rem 2.25rem; border-radius: var(--radius-md);
        font-size: 1rem; font-weight: 600; transition: background 0.15s;
      ">
        进入工作台
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

</Layout>

<style>
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
</style>
