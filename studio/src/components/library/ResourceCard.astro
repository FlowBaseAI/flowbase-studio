---
import Badge from '../ui/Badge.astro'

interface Props {
  name: string
  name_zh?: string
  description: string
  slug: string
  href: string
  tags?: string[]
  badge?: string
  badgeVariant?: 'default' | 'accent' | 'success' | 'warning' | 'muted'
  source?: string
  author?: string
  githubUrl?: string
  stars?: number
  updatedAt?: string
  meta?: string
}

const { name, name_zh, description, slug, href, tags = [], badge, badgeVariant = 'default', source, author, githubUrl, stars, updatedAt, meta } = Astro.props
const updatedLabel = updatedAt ? updatedAt.slice(0, 10) : undefined
---
<a
  href={href}
  class="resource-card"
  style="
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.125rem;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
    height: 100%;
  "
>
  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.375rem;">
    <div style="min-width: 0; flex: 1;">
      {name_zh ? (
        <div>
          <h3 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-text); margin: 0; line-height: 1.3;">
            {name_zh}
          </h3>
          <div style="font-size: 0.75rem; color: var(--color-text-subtle); margin-top: 0.125rem; font-family: var(--font-mono);">
            {name}
          </div>
        </div>
      ) : (
        <h3 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-text); margin: 0; line-height: 1.3;">
          {name}
        </h3>
      )}
    </div>
    {badge && <Badge variant={badgeVariant}>{badge}</Badge>}
  </div>

  <p style="font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; margin: 0.5rem 0 0.75rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
    {description}
  </p>

  <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
    <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
      {tags.slice(0, 3).map(tag => (
        <span style="
          font-size: 0.6875rem;
          color: var(--color-text-subtle);
          background: var(--color-surface-2);
          border: 1px solid var(--color-border);
          border-radius: 3px;
          padding: 0.1rem 0.4rem;
        ">{tag}</span>
      ))}
    </div>
    {stars !== undefined && (
      <span style="font-size: 0.6875rem; color: var(--color-text-subtle); white-space: nowrap; flex-shrink: 0;">
        ★ {stars.toLocaleString()}
      </span>
    )}
  </div>

  {(source || author || githubUrl || updatedLabel || meta) && (
    <div style="display: flex; flex-wrap: wrap; gap: 0.375rem 0.625rem; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border);">
      {(source || meta) && (
        <span style="font-size: 0.6875rem; color: var(--color-text-subtle);">
          Source: {source ?? meta}
        </span>
      )}
      {author && (
        <span style="font-size: 0.6875rem; color: var(--color-text-subtle);">
          Author: {author}
        </span>
      )}
      {githubUrl && (
        <span style="font-size: 0.6875rem; color: var(--color-text-subtle);">
          GitHub
        </span>
      )}
      {updatedLabel && (
        <span style="font-size: 0.6875rem; color: var(--color-text-subtle);">
          Updated: {updatedLabel}
        </span>
      )}
    </div>
  )}
</a>

<style>
.resource-card:hover {
  border-color: var(--color-border-2) !important;
  background: var(--color-surface-2) !important;
}
</style>
