---
import Badge from '../ui/Badge.astro'

interface Props {
  name: string
  description: string
  slug: string
  href: string
  tags?: string[]
  badge?: string
  badgeVariant?: 'default' | 'accent' | 'success' | 'warning' | 'muted'
  meta?: string
}

const { name, description, slug, href, tags = [], badge, badgeVariant = 'default', meta } = Astro.props
---
<a
  href={href}
  style="
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.125rem;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
    height: 100%;
  "
  onmouseover="this.style.borderColor='var(--color-border-2)'; this.style.background='var(--color-surface-2)'"
  onmouseout="this.style.borderColor='var(--color-border)'; this.style.background='var(--color-surface)'"
>
  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.5rem;">
    <h3 style="font-size: 0.9375rem; font-weight: 600; color: var(--color-text); margin: 0; line-height: 1.3;">
      {name}
    </h3>
    {badge && <Badge variant={badgeVariant}>{badge}</Badge>}
  </div>

  <p style="font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; margin: 0 0 0.875rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
    {description}
  </p>

  <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
    <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
      {tags.slice(0, 3).map(tag => (
        <span style="
          font-size: 0.6875rem;
          color: var(--color-text-subtle);
          background: var(--color-surface-2);
          border: 1px solid var(--color-border);
          border-radius: 3px;
          padding: 0.1rem 0.4rem;
        ">{tag}</span>
      ))}
    </div>
    {meta && <span style="font-size: 0.75rem; color: var(--color-text-subtle); white-space: nowrap;">{meta}</span>}
  </div>
</a>
