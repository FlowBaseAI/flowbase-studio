---
const nav = [
  { href: '/workspace', label: 'Workspace' },
  { href: '/mcp', label: 'MCP' },
  { href: '/skills', label: 'Skills' },
  { href: '/rules', label: 'Rules' },
]
const currentPath = Astro.url.pathname
---
<header style="
  position: sticky; top: 0; z-index: 50;
  background: rgba(10,10,10,0.85);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-border);
">
  <div style="max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; height: 56px; display: flex; align-items: center; gap: 2rem;">
    <a href="/" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; flex-shrink: 0;">
      <div style="
        width: 28px; height: 28px; border-radius: 6px;
        background: var(--color-accent);
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; font-weight: 700; color: white;
      ">F</div>
      <span style="font-weight: 600; font-size: 0.95rem; color: var(--color-text); letter-spacing: -0.01em;">
        FlowBase Studio
      </span>
    </a>

    <nav style="display: flex; align-items: center; gap: 0.25rem; flex: 1;">
      {nav.map(item => (
        <a
          href={item.href}
          style={`
            padding: 0.375rem 0.75rem;
            border-radius: var(--radius-sm);
            font-size: 0.875rem;
            text-decoration: none;
            transition: background 0.15s, color 0.15s;
            ${currentPath.startsWith(item.href)
              ? 'color: var(--color-text); background: var(--color-surface-2);'
              : 'color: var(--color-text-muted);'}
          `}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <a href="/search" style="
        color: var(--color-text-muted);
        text-decoration: none;
        display: flex; align-items: center;
        padding: 0.375rem;
        border-radius: var(--radius-sm);
        transition: color 0.15s;
      " title="Search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </a>
      <a href="/workspace" style="
        background: var(--color-accent);
        color: white;
        text-decoration: none;
        padding: 0.375rem 0.875rem;
        border-radius: var(--radius-sm);
        font-size: 0.8125rem;
        font-weight: 500;
        transition: background 0.15s;
        white-space: nowrap;
      ">
        Open Studio
      </a>
    </div>
  </div>
</header>
