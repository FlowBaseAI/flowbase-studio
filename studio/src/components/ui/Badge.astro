---
interface Props {
  variant?: 'default' | 'accent' | 'success' | 'warning' | 'muted'
}
const { variant = 'default' } = Astro.props

const styles: Record<string, string> = {
  default: 'background: var(--color-surface-2); color: var(--color-text-muted); border: 1px solid var(--color-border);',
  accent: 'background: var(--color-accent-subtle); color: var(--color-accent); border: 1px solid rgba(91,106,248,0.2);',
  success: 'background: rgba(34,197,94,0.1); color: var(--color-success); border: 1px solid rgba(34,197,94,0.2);',
  warning: 'background: rgba(245,158,11,0.1); color: var(--color-warning); border: 1px solid rgba(245,158,11,0.2);',
  muted: 'background: transparent; color: var(--color-text-subtle); border: 1px solid var(--color-border);',
}
---
<span style={`
  display: inline-flex; align-items: center;
  padding: 0.125rem 0.5rem;
  border-radius: 3px;
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  white-space: nowrap;
  ${styles[variant]}
`}>
  <slot />
</span>
