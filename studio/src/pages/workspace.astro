---
import Layout from '../components/layout/Layout.astro'
import { getCollection } from 'astro:content'

const mcps = await getCollection('mcp')
const skills = await getCollection('skills')
const rules = await getCollection('rules')

const sortedMcps = mcps.sort((a, b) => a.data.order - b.data.order)
const sortedSkills = skills.sort((a, b) => a.data.order - b.data.order)
const sortedRules = rules.sort((a, b) => a.data.order - b.data.order)

// Serialize all data for client-side use
const mcpData = sortedMcps.map(m => ({
  slug: m.id,
  name: m.data.name,
  description: m.data.description,
  category: m.data.category,
  tags: m.data.tags,
  install_cmd: m.data.install_cmd,
  config_snippet: m.data.config_snippet,
  is_featured: m.data.is_featured,
}))

const skillData = sortedSkills.map(s => ({
  slug: s.id,
  name: s.data.name,
  description: s.data.description,
  category: s.data.category,
  difficulty: s.data.difficulty,
  file_name: s.data.file_name,
}))

const ruleData = sortedRules.map(r => ({
  slug: r.id,
  name: r.data.name,
  description: r.data.description,
  category: r.data.category,
  rule_type: r.data.rule_type,
  file_name: r.data.file_name,
}))
---
<Layout
  title="Workspace"
  description="Build your Claude Code project visually — select MCP, Skills, and Rules, then generate and download."
>
  <div id="workspace-app" style="
    max-width: 1280px; margin: 0 auto; padding: 1.5rem;
    display: grid; grid-template-columns: 1fr 380px; gap: 1.5rem;
    min-height: calc(100vh - 56px - 80px);
    align-items: start;
  ">

    <!-- Left: Config panel -->
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">

      <!-- Header -->
      <div>
        <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.25rem; letter-spacing: -0.02em;">
          Workspace
        </h1>
        <p style="font-size: 0.875rem; color: var(--color-text-muted); margin: 0;">
          选择 MCP、Skills、Rules，点击 Generate 获得完整项目配置。
        </p>
      </div>

      <!-- Project Settings -->
      <div style="
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: var(--radius-md); padding: 1.25rem;
      ">
        <h2 style="font-size: 0.8125rem; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 1rem;">
          Project
        </h2>
        <div style="display: flex; flex-direction: column; gap: 0.875rem;">
          <div>
            <label style="display:block;font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.375rem;" for="project-name">
              Project Name
            </label>
            <input
              id="project-name"
              type="text"
              value="my-project"
              style="
                width: 100%; background: var(--color-surface-2);
                border: 1px solid var(--color-border); border-radius: var(--radius-sm);
                padding: 0.5rem 0.75rem; font-size: 0.875rem; color: var(--color-text);
                font-family: inherit; outline: none; transition: border-color 0.15s;
                box-sizing: border-box;
              "
            />
          </div>
          <div>
            <label style="display:block;font-size:0.8125rem;color:var(--color-text-muted);margin-bottom:0.5rem;">
              Platform
            </label>
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              {['claude-code', 'codex', 'gemini-cli'].map(p => (
                <label style="display:flex;align-items:center;gap:0.375rem;cursor:pointer;">
                  <input
                    type="radio"
                    name="platform"
                    value={p}
                    checked={p === 'claude-code'}
                    style="accent-color: var(--color-accent); cursor: pointer;"
                  />
                  <span style="font-size:0.875rem;color:var(--color-text-muted);">{p}</span>
                </label>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- MCP Section -->
      <div style="
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: var(--radius-md); overflow: hidden;
      ">
        <div style="
          padding: 0.875rem 1.25rem;
          border-bottom: 1px solid var(--color-border);
          display: flex; align-items: center; justify-content: space-between;
        ">
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <h2 style="font-size:0.8125rem;font-weight:600;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:0.05em;margin:0;">MCP</h2>
            <span id="mcp-count" style="font-size:0.75rem;background:var(--color-accent-subtle);color:var(--color-accent);padding:0.1rem 0.4rem;border-radius:3px;">0</span>
          </div>
          <input
            id="mcp-search"
            type="text"
            placeholder="搜索 MCP..."
            style="
              background: var(--color-surface-2); border: 1px solid var(--color-border);
              border-radius: var(--radius-sm); padding: 0.3rem 0.625rem;
              font-size: 0.8125rem; color: var(--color-text); font-family: inherit;
              outline: none; width: 160px; transition: border-color 0.15s;
            "
          />
        </div>
        <div id="mcp-list" style="max-height: 280px; overflow-y: auto; padding: 0.5rem;">
          <!-- populated by JS -->
        </div>
      </div>

      <!-- Skills Section -->
      <div style="
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: var(--radius-md); overflow: hidden;
      ">
        <div style="
          padding: 0.875rem 1.25rem; border-bottom: 1px solid var(--color-border);
          display: flex; align-items: center; justify-content: space-between;
        ">
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <h2 style="font-size:0.8125rem;font-weight:600;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:0.05em;margin:0;">Skills</h2>
            <span id="skill-count" style="font-size:0.75rem;background:var(--color-accent-subtle);color:var(--color-accent);padding:0.1rem 0.4rem;border-radius:3px;">0</span>
          </div>
          <input
            id="skill-search"
            type="text"
            placeholder="搜索 Skills..."
            style="
              background: var(--color-surface-2); border: 1px solid var(--color-border);
              border-radius: var(--radius-sm); padding: 0.3rem 0.625rem;
              font-size: 0.8125rem; color: var(--color-text); font-family: inherit;
              outline: none; width: 160px; transition: border-color 0.15s;
            "
          />
        </div>
        <div id="skill-list" style="max-height: 280px; overflow-y: auto; padding: 0.5rem;">
        </div>
      </div>

      <!-- Rules Section -->
      <div style="
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: var(--radius-md); overflow: hidden;
      ">
        <div style="
          padding: 0.875rem 1.25rem; border-bottom: 1px solid var(--color-border);
          display: flex; align-items: center; justify-content: space-between;
        ">
          <div style="display:flex;align-items:center;gap:0.5rem;">
            <h2 style="font-size:0.8125rem;font-weight:600;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:0.05em;margin:0;">Rules</h2>
            <span id="rule-count" style="font-size:0.75rem;background:var(--color-accent-subtle);color:var(--color-accent);padding:0.1rem 0.4rem;border-radius:3px;">0</span>
          </div>
          <input
            id="rule-search"
            type="text"
            placeholder="搜索 Rules..."
            style="
              background: var(--color-surface-2); border: 1px solid var(--color-border);
              border-radius: var(--radius-sm); padding: 0.3rem 0.625rem;
              font-size: 0.8125rem; color: var(--color-text); font-family: inherit;
              outline: none; width: 160px; transition: border-color 0.15s;
            "
          />
        </div>
        <div id="rule-list" style="max-height: 280px; overflow-y: auto; padding: 0.5rem;">
        </div>
      </div>

    </div>

    <!-- Right: Output panel -->
    <div style="position: sticky; top: 72px; display: flex; flex-direction: column; gap: 1rem;">

      <div style="
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: var(--radius-md); overflow: hidden;
      ">
        <div style="padding: 0.875rem 1.25rem; border-bottom: 1px solid var(--color-border);">
          <h2 style="font-size:0.8125rem;font-weight:600;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:0.05em;margin:0;">Output</h2>
        </div>

        <!-- File tree preview -->
        <div id="file-tree" style="padding: 0.875rem 1.25rem; font-family: var(--font-mono); font-size: 0.8125rem;">
          <div style="color: var(--color-text-muted); line-height: 1.8;">
            <div id="tree-root" style="color: var(--color-text);">📁 <span id="tree-project-name">my-project</span>/</div>
            <div style="padding-left: 1rem;">
              <div style="color: var(--color-text-muted);">├── CLAUDE.md</div>
              <div style="color: var(--color-text-muted);">├── .claude/</div>
              <div style="padding-left: 1rem; color: var(--color-text-subtle);">└── settings.json</div>
              <div id="tree-skills" style="display:none;">
                <div style="color: var(--color-text-muted);">├── skills/</div>
                <div id="tree-skills-list" style="padding-left: 1rem; color: var(--color-text-subtle);"></div>
              </div>
              <div id="tree-rules" style="display:none;">
                <div style="color: var(--color-text-muted);">└── rules/</div>
                <div id="tree-rules-list" style="padding-left: 1rem; color: var(--color-text-subtle);"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Selected summary -->
        <div id="selection-summary" style="
          border-top: 1px solid var(--color-border);
          padding: 0.875rem 1.25rem;
          font-size: 0.8125rem; color: var(--color-text-subtle);
          line-height: 1.6;
        ">
          未选择任何资源。
        </div>

        <!-- Action buttons -->
        <div style="border-top: 1px solid var(--color-border); padding: 0.875rem 1.25rem; display: flex; flex-direction: column; gap: 0.5rem;">
          <button
            id="btn-download"
            style="
              width: 100%; background: var(--color-accent); color: white; border: none;
              padding: 0.75rem; border-radius: var(--radius-sm);
              font-size: 0.9rem; font-weight: 600; cursor: pointer;
              font-family: inherit; transition: background 0.15s;
              display: flex; align-items: center; justify-content: center; gap: 0.5rem;
            "
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
            </svg>
            Export ZIP
          </button>
          <button
            id="btn-copy"
            style="
              width: 100%; background: var(--color-surface-2); color: var(--color-text-muted);
              border: 1px solid var(--color-border); padding: 0.625rem;
              border-radius: var(--radius-sm); font-size: 0.875rem; font-weight: 500;
              cursor: pointer; font-family: inherit; transition: all 0.15s;
              display: flex; align-items: center; justify-content: center; gap: 0.5rem;
            "
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <span id="copy-label">Copy settings.json</span>
          </button>
          <button
            id="btn-reset"
            style="
              width: 100%; background: transparent; color: var(--color-text-subtle);
              border: 1px solid transparent; padding: 0.4rem;
              border-radius: var(--radius-sm); font-size: 0.8125rem;
              cursor: pointer; font-family: inherit; transition: all 0.15s;
            "
          >
            清除选择
          </button>
        </div>
      </div>

      <!-- Toast -->
      <div id="toast" style="
        display: none;
        background: var(--color-surface-2); border: 1px solid var(--color-border);
        border-radius: var(--radius-md); padding: 0.75rem 1rem;
        font-size: 0.875rem; color: var(--color-text);
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
      "></div>

    </div>
  </div>
</Layout>

<script define:vars={{ mcpData, skillData, ruleData }}>
  // ---- State ----
  const STORAGE_KEY = 'fbs:workspace:'
  function loadState() {
    try {
      return {
        projectName: localStorage.getItem(STORAGE_KEY + 'projectName') ?? 'my-project',
        platform: localStorage.getItem(STORAGE_KEY + 'platform') ?? 'claude-code',
        selectedMcps: JSON.parse(localStorage.getItem(STORAGE_KEY + 'selectedMcps') ?? '[]'),
        selectedSkills: JSON.parse(localStorage.getItem(STORAGE_KEY + 'selectedSkills') ?? '[]'),
        selectedRules: JSON.parse(localStorage.getItem(STORAGE_KEY + 'selectedRules') ?? '[]'),
      }
    } catch {
      return { projectName: 'my-project', platform: 'claude-code', selectedMcps: [], selectedSkills: [], selectedRules: [] }
    }
  }
  function saveState() {
    localStorage.setItem(STORAGE_KEY + 'projectName', state.projectName)
    localStorage.setItem(STORAGE_KEY + 'platform', state.platform)
    localStorage.setItem(STORAGE_KEY + 'selectedMcps', JSON.stringify(state.selectedMcps))
    localStorage.setItem(STORAGE_KEY + 'selectedSkills', JSON.stringify(state.selectedSkills))
    localStorage.setItem(STORAGE_KEY + 'selectedRules', JSON.stringify(state.selectedRules))
  }

  const state = loadState()

  // ---- DOM refs ----
  const projectNameInput = document.getElementById('project-name')
  const platformRadios = document.querySelectorAll('input[name="platform"]')
  const mcpList = document.getElementById('mcp-list')
  const skillList = document.getElementById('skill-list')
  const ruleList = document.getElementById('rule-list')
  const mcpSearch = document.getElementById('mcp-search')
  const skillSearch = document.getElementById('skill-search')
  const ruleSearch = document.getElementById('rule-search')
  const mcpCount = document.getElementById('mcp-count')
  const skillCount = document.getElementById('skill-count')
  const ruleCount = document.getElementById('rule-count')
  const treeProjectName = document.getElementById('tree-project-name')
  const treeSkills = document.getElementById('tree-skills')
  const treeRules = document.getElementById('tree-rules')
  const treeSkillsList = document.getElementById('tree-skills-list')
  const treeRulesList = document.getElementById('tree-rules-list')
  const selectionSummary = document.getElementById('selection-summary')
  const toast = document.getElementById('toast')
  const btnDownload = document.getElementById('btn-download')
  const btnCopy = document.getElementById('btn-copy')
  const btnReset = document.getElementById('btn-reset')
  const copyLabel = document.getElementById('copy-label')

  // ---- Init form ----
  if (projectNameInput) projectNameInput.value = state.projectName
  platformRadios.forEach(r => { if (r.value === state.platform) r.checked = true })

  // ---- Render list ----
  function renderCheckItem(slug, name, description, isSelected, type) {
    const div = document.createElement('div')
    div.style.cssText = `
      display: flex; align-items: flex-start; gap: 0.625rem;
      padding: 0.5rem 0.625rem; border-radius: 6px; cursor: pointer;
      transition: background 0.1s;
      ${isSelected ? 'background: var(--color-accent-subtle);' : ''}
    `
    div.onmouseenter = () => { if (!div.querySelector('input').checked) div.style.background = 'var(--color-surface-2)' }
    div.onmouseleave = () => { if (!div.querySelector('input').checked) div.style.background = '' }

    const cb = document.createElement('input')
    cb.type = 'checkbox'
    cb.checked = isSelected
    cb.style.cssText = 'accent-color: var(--color-accent); margin-top: 2px; flex-shrink: 0; cursor: pointer;'

    const info = document.createElement('div')
    info.style.cssText = 'flex: 1; min-width: 0;'

    const nameEl = document.createElement('div')
    nameEl.style.cssText = 'font-size: 0.875rem; font-weight: 500; color: var(--color-text); line-height: 1.3;'
    nameEl.textContent = name

    const descEl = document.createElement('div')
    descEl.style.cssText = 'font-size: 0.75rem; color: var(--color-text-subtle); line-height: 1.4; margin-top: 0.125rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;'
    descEl.textContent = description

    info.appendChild(nameEl)
    info.appendChild(descEl)
    div.appendChild(cb)
    div.appendChild(info)

    div.addEventListener('click', (e) => {
      if (e.target === cb) return
      cb.checked = !cb.checked
      cb.dispatchEvent(new Event('change'))
    })

    cb.addEventListener('change', () => {
      if (cb.checked) {
        if (type === 'mcp' && !state.selectedMcps.includes(slug)) state.selectedMcps.push(slug)
        if (type === 'skill' && !state.selectedSkills.includes(slug)) state.selectedSkills.push(slug)
        if (type === 'rule' && !state.selectedRules.includes(slug)) state.selectedRules.push(slug)
        div.style.background = 'var(--color-accent-subtle)'
      } else {
        if (type === 'mcp') state.selectedMcps = state.selectedMcps.filter(s => s !== slug)
        if (type === 'skill') state.selectedSkills = state.selectedSkills.filter(s => s !== slug)
        if (type === 'rule') state.selectedRules = state.selectedRules.filter(s => s !== slug)
        div.style.background = ''
      }
      saveState()
      updateOutput()
    })

    return div
  }

  function renderList(containerId, items, selectedSlugs, type, searchQuery = '') {
    const container = document.getElementById(containerId)
    if (!container) return
    container.innerHTML = ''
    const q = searchQuery.toLowerCase()
    const filtered = q
      ? items.filter(i => i.name.toLowerCase().includes(q) || i.description.toLowerCase().includes(q))
      : items
    if (filtered.length === 0) {
      container.innerHTML = `<div style="padding: 1rem; text-align: center; font-size: 0.8125rem; color: var(--color-text-subtle);">无匹配结果</div>`
      return
    }
    filtered.forEach(item => {
      container.appendChild(renderCheckItem(item.slug, item.name, item.description, selectedSlugs.includes(item.slug), type))
    })
  }

  function updateOutput() {
    // counts
    if (mcpCount) mcpCount.textContent = state.selectedMcps.length.toString()
    if (skillCount) skillCount.textContent = state.selectedSkills.length.toString()
    if (ruleCount) ruleCount.textContent = state.selectedRules.length.toString()

    // tree
    if (treeProjectName) treeProjectName.textContent = state.projectName || 'my-project'

    const selectedSkillObjs = skillData.filter(s => state.selectedSkills.includes(s.slug))
    const selectedRuleObjs = ruleData.filter(r => state.selectedRules.includes(r.slug))

    if (treeSkills) treeSkills.style.display = selectedSkillObjs.length ? '' : 'none'
    if (treeRules) treeRules.style.display = selectedRuleObjs.length ? '' : 'none'

    if (treeSkillsList) {
      treeSkillsList.innerHTML = selectedSkillObjs.map((s, i) =>
        `<div style="color:var(--color-text-subtle);">${i < selectedSkillObjs.length - 1 ? '├' : '└'}── ${s.file_name}</div>`
      ).join('')
    }
    if (treeRulesList) {
      treeRulesList.innerHTML = selectedRuleObjs.map((r, i) =>
        `<div style="color:var(--color-text-subtle);">${i < selectedRuleObjs.length - 1 ? '├' : '└'}── ${r.file_name}</div>`
      ).join('')
    }

    // summary
    const total = state.selectedMcps.length + state.selectedSkills.length + state.selectedRules.length
    if (selectionSummary) {
      if (total === 0) {
        selectionSummary.textContent = '未选择任何资源。'
      } else {
        selectionSummary.innerHTML = [
          state.selectedMcps.length ? `<span style="color:var(--color-text);">${state.selectedMcps.length}</span> MCP` : '',
          state.selectedSkills.length ? `<span style="color:var(--color-text);">${state.selectedSkills.length}</span> Skills` : '',
          state.selectedRules.length ? `<span style="color:var(--color-text);">${state.selectedRules.length}</span> Rules` : '',
        ].filter(Boolean).join(' · ') + ' 已选择'
      }
    }
  }

  function renderAllLists(mcpQ = '', skillQ = '', ruleQ = '') {
    renderList('mcp-list', mcpData, state.selectedMcps, 'mcp', mcpQ)
    renderList('skill-list', skillData, state.selectedSkills, 'skill', skillQ)
    renderList('rule-list', ruleData, state.selectedRules, 'rule', ruleQ)
    updateOutput()
  }

  // ---- Event listeners ----
  projectNameInput?.addEventListener('input', (e) => {
    state.projectName = e.target.value
    saveState()
    updateOutput()
  })

  platformRadios.forEach(r => {
    r.addEventListener('change', () => {
      state.platform = r.value
      saveState()
    })
  })

  mcpSearch?.addEventListener('input', (e) => renderList('mcp-list', mcpData, state.selectedMcps, 'mcp', e.target.value))
  skillSearch?.addEventListener('input', (e) => renderList('skill-list', skillData, state.selectedSkills, 'skill', e.target.value))
  ruleSearch?.addEventListener('input', (e) => renderList('rule-list', ruleData, state.selectedRules, 'rule', e.target.value))

  // ---- Generate / Export ----
  function generateFiles() {
    const projectName = state.projectName || 'my-project'
    const selectedMcpObjs = mcpData.filter(m => state.selectedMcps.includes(m.slug))
    const selectedSkillObjs = skillData.filter(s => state.selectedSkills.includes(s.slug))
    const selectedRuleObjs = ruleData.filter(r => state.selectedRules.includes(r.slug))

    // CLAUDE.md
    const claudeMd = [
      `# ${projectName}`,
      '',
      '## Project Setup',
      '',
      `**Platform:** ${state.platform}`,
      '',
      ...(selectedMcpObjs.length ? [
        '## MCP Servers', '',
        ...selectedMcpObjs.map(m => `- **${m.name}**: ${m.description}`),
        '',
      ] : []),
      ...(selectedSkillObjs.length ? [
        '## Skills', '',
        ...selectedSkillObjs.map(s => `- \`skills/${s.file_name}\``),
        '',
      ] : []),
      ...(selectedRuleObjs.length ? [
        '## Rules', '',
        ...selectedRuleObjs.map(r => `- \`rules/${r.file_name}\``),
        '',
      ] : []),
      '> Generated by [FlowBase Studio](https://flowbase.studio)',
      '',
    ].join('\n')

    // settings.json
    const mcpServers = {}
    for (const mcp of selectedMcpObjs) {
      const snippet = mcp.config_snippet
      if (snippet && snippet.mcpServers) {
        Object.assign(mcpServers, snippet.mcpServers)
      }
    }
    const settings = { model: 'claude-opus-4-5', ...(Object.keys(mcpServers).length ? { mcpServers } : {}) }

    return { claudeMd, settings, selectedSkillObjs, selectedRuleObjs, projectName }
  }

  function showToast(msg, color = 'var(--color-success)') {
    if (!toast) return
    toast.textContent = msg
    toast.style.display = 'block'
    toast.style.borderColor = color === 'var(--color-success)' ? 'rgba(34,197,94,0.3)' : 'var(--color-border)'
    toast.style.color = color
    setTimeout(() => { toast.style.display = 'none' }, 3000)
  }

  btnDownload?.addEventListener('click', async () => {
    const { default: JSZip } = await import('jszip')
    const { claudeMd, settings, selectedSkillObjs, selectedRuleObjs, projectName } = generateFiles()

    const zip = new JSZip()
    const folder = zip.folder(projectName)!
    folder.file('CLAUDE.md', claudeMd)

    const claudeDir = folder.folder('.claude')!
    claudeDir.file('settings.json', JSON.stringify(settings, null, 2))

    if (selectedSkillObjs.length) {
      const skillsDir = folder.folder('skills')!
      for (const s of selectedSkillObjs) {
        skillsDir.file(s.file_name, `# ${s.name}\n\n${s.description}\n\n[See full skill at FlowBase Studio]`)
      }
    }

    if (selectedRuleObjs.length) {
      const rulesDir = folder.folder('rules')!
      for (const r of selectedRuleObjs) {
        rulesDir.file(r.file_name, `# ${r.name}\n\n${r.description}\n\n[See full rule at FlowBase Studio]`)
      }
    }

    const blob = await zip.generateAsync({ type: 'blob' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url; a.download = `${projectName}.zip`
    document.body.appendChild(a); a.click()
    document.body.removeChild(a); URL.revokeObjectURL(url)
    showToast(`✓ ${projectName}.zip 下载成功`)
  })

  btnCopy?.addEventListener('click', async () => {
    const { settings } = generateFiles()
    await navigator.clipboard.writeText(JSON.stringify(settings, null, 2))
    if (copyLabel) copyLabel.textContent = '✓ 已复制'
    setTimeout(() => { if (copyLabel) copyLabel.textContent = 'Copy settings.json' }, 2000)
    showToast('✓ settings.json 已复制到剪贴板')
  })

  btnReset?.addEventListener('click', () => {
    state.selectedMcps = []
    state.selectedSkills = []
    state.selectedRules = []
    saveState()
    renderAllLists()
  })

  // ---- Initial render ----
  renderAllLists()
</script>
